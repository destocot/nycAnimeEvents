generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum EventCategory {
  CONVENTION
  SCREENING
  MEETUP
  SALE
  PERFORMANCE
  OTHER
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole? @default(USER)
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")
  sessions      Session[]
  accounts      Account[]
  events        Event[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expiresAt      DateTime @map("expires_at")
  token          String   @unique
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  @@index([identifier])
  @@map("verifications")
}

model Event {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title       String
  slug        String        @unique
  description String?
  startDate   DateTime      @map("start_date")
  startTime   String?       @map("start_time")
  endTime     String?       @map("end_time")
  location    String
  address     String?
  websiteUrl  String?       @map("website_url")
  category    EventCategory @default(OTHER)
  status      EventStatus   @default(PENDING)
  featured      Boolean       @default(false)
  passed        Boolean       @default(false)
  archivedDates String?       @map("archived_dates")

  submittedById String? @map("submitted_by_id")
  submittedBy   User?   @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  image         EventImage?
  dates         EventDate[]

  @@index([status])
  @@index([startDate])
  @@map("events")
}

model EventDate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  date    DateTime

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_dates")
}

model EventImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  cloudinaryId String  @map("cloudinary_id")
  url          String
  width        Int?
  height       Int?
  format       String?
  alt          String?

  eventId String @unique @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_images")
}
